# Valgfrie innstillinger for lokal kjøring. Ingenting her trengs for vanlig oppsett.
# Kopier fila til .env for å bruke dem (.env er git-ignorert).
# .env leses bare lokalt, aldri på Vercel. Legg aldri SECRET_KEY eller DATABASE_URL her.

# Djangos feilsøkingssider lokalt: 1 slår dem på. Standard er av.
DEBUG=0

# Valgfri lokal språkmodell (FR-28). Tomt betyr av; brukes først når funksjonen er bygd.
PROGNOSE_LLM_URL=
PROGNOSE_LLM_MODEL=
